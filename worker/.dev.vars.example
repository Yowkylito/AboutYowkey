# Copy to .dev.vars (gitignored) for `npm run dev`. On Cloudflare these are secrets: `npx wrangler secret put ADMIN_TOKEN`.
# ADMIN_TOKEN is the inbox password; VISITOR_SALT makes the daily visitor ids unguessable. Long and random, both.
# FCM_SERVICE_ACCOUNT, the Firebase key that sends pushes, is best left out here: without it alerts are only records,
# and nothing reaches Google from `npm run dev`.
ADMIN_TOKEN=replace-me
VISITOR_SALT=replace-me-too
