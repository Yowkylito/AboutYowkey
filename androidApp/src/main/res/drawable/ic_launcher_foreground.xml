<?xml version="1.0" encoding="utf-8"?>
<!--
  favicon.svg's Y. Its 64-unit square is the full-bleed icon, so it maps onto the adaptive icon's inner 72 of 108 dp
  (scale 72/64, offset 18), the same crop docs/DEVELOPMENT.md asks of the project icons.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="1.125"
        android:scaleY="1.125"
        android:translateX="18"
        android:translateY="18">
        <path
            android:fillColor="#00000000"
            android:pathData="M18,16 L32,34 L46,16 M32,34 V50"
            android:strokeWidth="7"
            android:strokeColor="#FFFFFF"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
