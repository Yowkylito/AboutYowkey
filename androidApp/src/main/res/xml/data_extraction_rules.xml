<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+: nothing goes to a cloud backup or to a new phone in a device-to-device transfer, which
  android:allowBackup="false" alone does not stop there. The owner's token is sealed with a Keystore key that stays on
  this phone; the rest (the push token, the alerts' place) is this phone's too. Signing in again on a new one is the way.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
