<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Only the window behind Compose. The page is light unless the visitor switches (ThemeStore), whatever the
      system's mode, so the window is the paper colour: a cold start shows no white or black flash.
    -->
    <style name="Theme.Yowkey" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:colorAccent">@color/yowkey_orange</item>
    </style>
</resources>
